package com.ub.CSI142.MotsheloSystem.service;

import com.ub.CSI142.MotsheloSystem.model.Member;
import com.ub.CSI142.MotsheloSystem.model.Contribution;
import com.ub.CSI142.MotsheloSystem.interfaces.Reportable;

import java.util.ArrayList;

public class MotsheloService implements Reportable {
    private ArrayList<Member> members;
    private ArrayList<Contribution> contributions;

    public MotsheloService() {
        members = new ArrayList<>();
        contributions = new ArrayList<>();
    }

    public void addMember(Member member) {
        members.add(member);
        System.out.println("Member added: " + member.getName());
    }

    public void removeMember(int memberId) {
        members.removeIf(m -> m.getMemberId() == memberId);
    }

    public void displayMembers() {
        for (Member m : members) {
            m.displayInfo();
        }
    }

    public void insertionSortById() {
        Member[] arr = members.toArray(new Member[0]);
        for (int i = 1; i < arr.length; i++) {
            Member key = arr[i];
            int j = i - 1;
            while (j >= 0 && arr[j].getMemberId() > key.getMemberId()) {
                arr[j + 1] = arr[j];
                j--;
            }
            arr[j + 1] = key;
        }
        members = new ArrayList<>();
        for (Member m : arr) members.add(m);
    }

    public void sortMembers() {
        insertionSortById();
    }

    public int binarySearchById(int targetId) {
        Member[] arr = members.toArray(new Member[0]);
        int low = 0;
        int high = arr.length - 1;
        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (arr[mid].getMemberId() == targetId) {
                return mid;
            } else if (arr[mid].getMemberId() < targetId) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }
        return -1;
    }

    public void searchMember(int memberId) {
        int index = binarySearchById(memberId);
        if (index != -1) {
            members.get(index).displayInfo();
        } else {
            System.out.println("Member not found.");
        }
    }

    public void addContribution(int memberId, double amount) {
        for (Member m : members) {
            if (m.getMemberId() == memberId) {
                m.addContribution(amount);
                contributions.add(new Contribution(m, amount));
                System.out.println("Contribution recorded.");
                return;
            }
        }
        System.out.println("Member not found.");
    }

    public double getTotalContributions() {
        double total = 0;
        for (Member m : members) {
            total += m.getTotalContribution();
        }
        return total;
    }

    @Override
    public void generateReport() {
        double totalPool = 0;
        System.out.println("\n===== MOTSHELO REPORT =====");
        for (Member m : members) {
            System.out.println("ID: " + m.getMemberId());
            System.out.println("Name: " + m.getName());
            System.out.println("Phone: " + m.getPhoneNumber());
            System.out.println("Total Contributed: " + m.getTotalContribution());
            System.out.println("-------------------------------");
            totalPool += m.getTotalContribution();
        }
        System.out.println("TOTAL POOL: P" + totalPool);
    }
}