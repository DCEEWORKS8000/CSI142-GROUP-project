package com.ub.csi142.motshelosystem.services;

import com.ub.csi142.motshelosystem.model.Member;
import com.ub.csi142.motshelosystem.model.Contribution;
import com.ub.csi142.motshelosystem.interfaces.Reportable;

import java.util.List;
import java.util.ArrayList;

public class MotsheloService implements Reportable {

    private List<Member> members;
    private List<Contribution> contributions;

    public MotsheloService(){
        members = new ArrayList<>();
        contributions = new ArrayList<>();
    }
    public void addMember(Member member) {
        members.add(member);
        System.out.println("Member added: " + member.getName());
    }

    public void removeMember(int memberId) {
        int index = binarySearchById(memberId);
        if (index != -1) {
            Member removed = members.remove(index);
            System.out.println("Member removed: " + removed.getName());
        } else {
            System.out.println("Member not found with ID: " + memberId);
        }
    }
    public void displayMembers() {
        if (members.isEmpty()) {
            System.out.println("No members to display.");
            return;
        }
        System.out.println("\n--- Members List ---");
        for (Member m : members) {
            m.displayInfo();
        }
    }

    public void sortMembers() {
        for (int i = 1; i < members.size(); i++) {
            Member key = members.get(i);
            int j = i - 1;
            while (j >= 0 && members.get(j).getMemberId() > key.getMemberId()) {
                members.set(j + 1, members.get(j));
                j--;
            }
            members.set(j + 1, key);
                }
            }
             public int binarySearchById(int memberId) {
             int low = 0;
             int high = members.size() - 1;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            if (members.get(mid).getMemberId() == memberId) {
                return mid;
            } else if (members.get(mid).getMemberId() < memberId) {
                low = mid + 1;
            } else
                 {
                high = mid - 1;
            }
        }
        return -1;
    }

    public void addContribution(int memberId, double amount) {
        int index = binarySearchById(memberId);
        if (index != -1) {
            Member m = members.get(index);
            m.addContribution(amount);
            contributions.add(new Contribution(m, amount));
            System.out.println("Contribution recorded for: " + m.getName());
        } else {
            System.out.println("Member not found with ID: " + memberId);
        }
    }

    public void searchMember(int memberId) {
        int index = binarySearchById(memberId);
        if (index != -1) {
            members.get(index).displayInfo();
        } else {
            System.out.println("Member not found with ID: " + memberId);
        }
    }

    public double getTotalContributions() {
        double total = 0;
        for (Member m : members) {
            total += m.getTotalContribution();
        }
        return total;
    }

    
    @Override
    public void generateReport() {
        double totalPool = 0;
        System.out.println("\n===== MOTSHELO REPORT =====");
        for (Member m : members) {
            m.displayInfo();
            totalPool += m.getTotalContribution();
        }
        System.out.println("TOTAL POOL: " + totalPool);
    }
}     
