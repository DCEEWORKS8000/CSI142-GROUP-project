package com.ub.CSI142.MotsheloSystem.app;

import com.ub.CSI142.MotsheloSystem.model.Member;
import com.ub.CSI142.MotsheloSystem.service.MotsheloService;

import java.util.Scanner;

public class MainApp {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        MotsheloService service = new MotsheloService();
        int choice;
        int nextId = 1;

        do {
            System.out.println("\n ********MOTSHELO SAVINGS SYSTEM********\n");
            System.out.println("1. Add member");
            System.out.println("2. Remove member");
            System.out.println("3. Show members");
            System.out.println("4. Add Contribution");
            System.out.println("5. Check contributions total");
            System.out.println("6. Search member");
            System.out.println("7. Sort members");
            System.out.println("0. Exit");
            System.out.print("Choose option: ");
            choice = in.nextInt();
            in.nextLine();

            switch (choice) {
                case 1:
                    System.out.print("Enter name: ");
                    String name = in.nextLine();
                    System.out.print("Enter phone number: ");
                    String phone = in.nextLine();
                    service.addMember(new Member(nextId++, name, phone));
                    break;
                case 2:
                    System.out.print("Enter member ID to remove: ");
                    int removeId = in.nextInt();
                    service.removeMember(removeId);
                    break;
                case 3:
                    service.displayMembers();
                    break;
                case 4:
                    System.out.print("Enter member ID: ");
                    int id = in.nextInt();
                    System.out.print("Enter contribution amount: ");
                    double amount = in.nextDouble();
                    service.addContribution(id, amount);
                    break;
                case 5:
                    System.out.println("Total Contributions: P" + service.getTotalContributions());
                    break;
                case 6:
                    System.out.print("Enter member ID to search: ");
                    int searchId = in.nextInt();
                    service.searchMember(searchId);
                    break;
                case 7:
                    service.sortMembers();
                    System.out.println("Members sorted successfully.");
                    break;
                case 0:
                    System.out.println("Exiting. Thank you!");
                    break;
                default:
                    System.out.println("Invalid choice.");
                    break;
            }
        } while (choice != 0);
    }
}